generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int          @id @default(autoincrement())
  username     String       @unique
  passwordHash String
  role         String       @default("EMPLOYEE")

  firstName    String?
  lastName     String?
  email        String?      @unique
  phone        String?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attendances         Attendance[]
  attendanceLocations AttendanceLocation[]
}

model Attendance {
  id              Int       @id @default(autoincrement())
  userId          Int

  inClientEventId String?   @unique
  outClientEventId String?  @unique

  photoUrl        String?
  latitude        Float
  longitude       Float

  inPunch         DateTime? @db.Timestamp(3)
  outPunch        DateTime? @db.Timestamp(3)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AttendanceLocation {
  id               Int       @id @default(autoincrement())
  clientLocationId String    @unique

  sessionEventId   String
  userId           Int

  latitude         Float
  longitude        Float

  capturedAt       DateTime  @db.Timestamp(3)
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionEventId, capturedAt])
  @@index([userId, capturedAt])
}